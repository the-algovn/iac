# Root credentials come from OpenBao KV `algovn/radio-lab/minio` (properties
# `username` / `password`) — the same entry the in-cluster `minio-root`
# ExternalSecret reads. The path is historical: MinIO was first stood up for
# radio-lab. They MUST match: the in-cluster provisioning Jobs (bucket-job,
# minio-provision-the-race) authenticate as root against minio.minio.svc, which
# points here after the cutover, and Tempo reads the very same entry.
MINIO_ROOT_USER={{ minio_root_user }}
MINIO_ROOT_PASSWORD={{ minio_root_password }}

# Without this, /minio/v2/metrics/cluster answers 403 — MinIO requires a signed JWT
# on its metrics endpoints by default, and vmagent sends none, so the scrape target
# sat at up=0 while MinIO itself served traffic normally. `public` is the right
# trade here rather than issuing vmagent a token: ufw already restricts 9000 to the
# three k3s node IPs, so the endpoint is not reachable from anywhere else on the LAN.
MINIO_PROMETHEUS_AUTH_TYPE=public
