#!/usr/bin/env bash
# obs — query production logs (Loki) and traces (Tempo) from a laptop.
#
# Everything runs through a temporary forward, so it needs no ingress and no
# long-lived credential: a service still in the cluster is reached with
# `kubectl port-forward`, one that has moved to a VM with an SSH tunnel.
#
#   obs errors [--since 1h]        errors across every application namespace
#   obs trace <trace_id>           every log line and span for one request
#   obs tail <ns> [container]      follow a namespace's logs
#   obs grep '<logql>' [--since 1h]  raw LogQL
set -euo pipefail

CONTEXT="${KUBE_CONTEXT:-algovn-remote}"
SINCE="1h"
LIMIT="${OBS_LIMIT:-1000}"

# forward() records each forward's pid in this file rather than a shell array:
# forward() is always called from inside a subshell (either the left side of a
# pipe, e.g. `loki_query ... | render`, or a `$(...)` command substitution), and
# a subshell's array writes never reach the parent shell. A file survives
# subshell boundaries, so this is what actually lets cleanup find and kill every
# forward it started.
PIDFILE=$(mktemp "${TMPDIR:-/tmp}/obs-pids.XXXXXX")

# The forwarders' stderr. It has to go somewhere other than the caller's stdout
# — forward() runs inside `$(...)`, and a background process holding that pipe
# open would hang the command substitution forever — but /dev/null would make an
# SSH failure (host down, ProxyJump through cp broken, key not loaded) completely
# opaque, so it is kept and printed on the failure path.
ERRFILE=$(mktemp "${TMPDIR:-/tmp}/obs-err.XXXXXX")

die() { echo "obs: $*" >&2; exit 1; }

cleanup() {
  if [[ -f "$PIDFILE" ]]; then
    while IFS= read -r pid; do
      [[ -n "$pid" ]] && kill "$pid" 2>/dev/null || true
    done < "$PIDFILE"
    rm -f "$PIDFILE"
  fi
  rm -f "$ERRFILE"
}
trap cleanup EXIT INT TERM

# free_port picks an unused local port so concurrent runs do not collide.
free_port() {
  python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()'
}

# service_host <service> — where that service actually runs. `cluster` means
# kubectl port-forward; anything else is an ssh(1) destination (a Host stanza in
# ~/.ssh/config) reached with a tunnel.
#
# This table is the whole point of the indirection. A service that has moved to a
# VM keeps its in-cluster DNS name through a **selector-less** Service, and
# `kubectl port-forward` cannot work against one: it resolves a Service to a pod
# via spec.selector, so it fails outright with "Service is defined without a
# selector". The apiserver service proxy is not a fallback either ("no endpoints
# available for service"), and the laptop is not on the cluster LAN, so an SSH
# tunnel — the same access path docs/runbooks/stateful-vms.md uses — is what is
# left.
#
# Phase 3 moves Tempo to algovn-obs too. Flip its value to `obs` in the same
# commit that removes the tempo chart source, or `obs trace` loses its span half
# exactly the way `obs errors` lost Loki in Phase 2.
service_host() {
  case "$1" in
    loki)  echo obs ;;       # algovn-obs since Phase 2
    tempo) echo data ;;
    *)     echo cluster ;;
  esac
}

# wait_for_port <pid> <local-port> <label> — poll until the forward answers and
# echo the local port. Returns 1, printing nothing to stdout, if the forwarder
# died or never came up.
#
# 100 x 100ms = 10s: algovn-remote is reached over a cloudflared tunnel and obs
# over a ProxyJump through cp, so a fresh forward can take a few seconds under
# load. A dead forwarder (e.g. Tempo's namespace not existing, or obs
# unreachable) is detected immediately below and does not wait out this budget.
wait_for_port() {
  local pid=$1 local_port=$2 label=$3 i
  for i in $(seq 1 100); do
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "obs: forward to $label failed to start" >&2
      tail -n 3 "$ERRFILE" >&2 || true
      return 1
    fi
    if curl -s -o /dev/null "http://127.0.0.1:$local_port" 2>/dev/null; then
      echo "$local_port"
      return 0
    fi
    sleep 0.1
  done
  echo "obs: timed out waiting for the forward to $label" >&2
  tail -n 3 "$ERRFILE" >&2 || true
  return 1
}

# forward <namespace> <service> <remote-port> -> echoes the local port.
# Returns 1 (and prints nothing to stdout) if the forward never becomes
# reachable.
forward() {
  local ns=$1 svc=$2 port=$3 host local_port pid label
  host=$(service_host "$svc")
  local_port=$(free_port)
  if [[ "$host" == "cluster" ]]; then
    label="$ns/$svc"
    kubectl --context "$CONTEXT" -n "$ns" port-forward "svc/$svc" "$local_port:$port" \
      >/dev/null 2>>"$ERRFILE" &
  else
    label="$svc on $host"
    # -n so the backgrounded ssh cannot consume the caller's stdin (`obs tail`
    # pipes through one), BatchMode so a missing key fails fast instead of
    # blocking on a passphrase prompt it has no terminal to show.
    ssh -n -o BatchMode=yes -o ExitOnForwardFailure=yes \
      -N -L "$local_port:localhost:$port" "$host" >/dev/null 2>>"$ERRFILE" &
  fi
  pid=$!
  echo "$pid" >> "$PIDFILE"
  wait_for_port "$pid" "$local_port" "$label"
}

loki_query() {
  local query=$1 since=$2 port
  port=$(forward logging loki 3100) || die "could not reach Loki"
  curl -sG "http://127.0.0.1:$port/loki/api/v1/query_range" \
    --data-urlencode "query=$query" \
    --data-urlencode "since=$since" \
    --data-urlencode "limit=$LIMIT" \
    --data-urlencode "direction=forward"
}

# render turns a Loki query_range response into readable, time-ordered lines.
# If there are zero matching lines, say so explicitly rather than printing
# nothing — an operator needs to tell "queried and found nothing" apart from
# "silently broke".
render() {
  local out
  out=$(jq -r '
    [ .data.result[]? as $s
      | $s.values[]
      | { ts: (.[0] | tonumber / 1e9),
          ns: ($s.stream.namespace // "?"),
          app: ($s.stream.container // $s.stream.pod // "?"),
          line: .[1] }
    ]
    | sort_by(.ts)[]
    | (.ts | strftime("%H:%M:%S")) + "  " + (.ns + "/" + .app | .[0:34]) + "  " +
      ( .line as $raw
        | ($raw
            | try (fromjson
                     | ((.level // "?") | ascii_upcase | .[0:5])
                       + " " + (.msg // "")
                       + " " + ([ to_entries[]
                                  | select(.key | IN("level","msg","time","service","trace_id","span_id","version","env") | not)
                                  | "\(.key)=\(.value)" ] | join(" ")))
                 catch $raw) )
  ')
  if [[ -z "$out" ]]; then
    echo "  (no matching lines)" >&2
  else
    printf '%s\n' "$out"
  fi
}

parse_since() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) SINCE="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
}

cmd_errors() {
  parse_since "$@"
  echo "== errors in the last $SINCE ==" >&2
  loki_query '{namespace=~"api-control-plane|the-button|radio-service|console"} | json | level="ERROR"' "$SINCE" | render
}

cmd_trace() {
  local id=${1:-}
  [[ -n "$id" ]] || die "usage: obs trace <trace_id>"

  echo "== logs for trace $id ==" >&2
  # Trace IDs are unique, so search every namespace and let Loki filter.
  loki_query "{namespace=~\".+\"} | json | trace_id=\"$id\"" "24h" | render

  echo >&2
  echo "== spans ==" >&2
  local port
  if port=$(forward tracing tempo 3200); then
    curl -s "http://127.0.0.1:$port/api/traces/$id" \
      | jq -r '
          if (.batches // []) == [] then "  (no spans — Tempo has not ingested this trace)"
          else
            [ .batches[]
              | (.resource.attributes[]? | select(.key=="service.name") | .value.stringValue) as $svc
              | .scopeSpans[]?.spans[]?
              | { svc: $svc, name: .name,
                  start: (.startTimeUnixNano | tonumber),
                  ms: (((.endTimeUnixNano | tonumber) - (.startTimeUnixNano | tonumber)) / 1e6) }
            ]
            | sort_by(.start)[]
            | "  " + (.svc + " " * 24 | .[0:24]) + "  " +
              (((.ms * 100 | round) / 100 | tostring) + "ms" + " " * 10 | .[0:10]) + "  " + .name
          end'
  else
    echo "  (spans unavailable — could not reach Tempo)"
  fi
}

cmd_tail() {
  local ns=${1:-} container=${2:-}
  [[ -n "$ns" ]] || die "usage: obs tail <namespace> [container]"
  local selector="{namespace=\"$ns\"}"
  [[ -n "$container" ]] && selector="{namespace=\"$ns\", container=\"$container\"}"

  local port
  port=$(forward logging loki 3100) || die "could not reach Loki"
  echo "== tailing $selector (ctrl-c to stop) ==" >&2
  # /loki/api/v1/tail is a WebSocket endpoint (it replies 400 Bad Request to
  # a plain GET); curl speaks WebSocket natively over the ws:// scheme and
  # writes the decoded frame payloads straight to stdout.
  #
  # The formatting step below is python3, not jq: verified against the live
  # endpoint, this machine's jq buffers its *entire* input until EOF before
  # emitting anything (true even with `jq --stream`), which for a tail that
  # never hits EOF means the operator would stare at a blank terminal until
  # Ctrl-C. python3's incremental JSON decoder prints each line as its frame
  # arrives instead; python3 is already a hard dependency (see free_port).
  curl -sN -G "ws://127.0.0.1:$port/loki/api/v1/tail" \
    --data-urlencode "query=$selector" \
    | python3 -u -c '
import sys, json, time

def run():
    decoder = json.JSONDecoder()
    buf = ""
    while True:
        chunk = sys.stdin.buffer.read1(4096).decode("utf-8", "replace")
        if chunk == "":
            break
        buf += chunk
        buf = buf.lstrip()
        while buf:
            try:
                obj, idx = decoder.raw_decode(buf)
            except ValueError:
                break
            buf = buf[idx:].lstrip()
            for s in obj.get("streams", []):
                container = s.get("stream", {}).get("container", "?")
                for v in s.get("values", []):
                    ts = time.strftime("%H:%M:%S", time.localtime(int(v[0]) / 1e9))
                    sys.stdout.write(f"{ts}  {container}  {v[1]}")
            sys.stdout.flush()

try:
    run()
except KeyboardInterrupt:
    pass
'
}

cmd_grep() {
  local query=${1:-}
  [[ -n "$query" ]] || die "usage: obs grep '<logql>' [--since 1h]"
  shift
  parse_since "$@"
  loki_query "$query" "$SINCE" | render
}

command -v jq >/dev/null || die "jq is required"
command -v kubectl >/dev/null || die "kubectl is required"
command -v ssh >/dev/null || die "ssh is required"

case "${1:-}" in
  errors) shift; cmd_errors "$@" ;;
  trace)  shift; cmd_trace  "$@" ;;
  tail)   shift; cmd_tail   "$@" ;;
  grep)   shift; cmd_grep   "$@" ;;
  # Usage is the leading comment block itself, found by scanning rather than by a
  # hardcoded line range — editing the header must not silently truncate --help.
  *) awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"; exit 1 ;;
esac
